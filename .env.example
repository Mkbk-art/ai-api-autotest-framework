# 可选的通用 OS 环境变量覆盖示例。
# 普通 SUT 配置优先使用对应 env.<project>.yaml；这些 API_* 变量主要面向 CI 临时覆盖。

# API_HOST=http://127.0.0.1:8000
# API_TIMEOUT=10
# API_VERIFY_SSL=false
# API_USE_MOCK=false
# LOG_LEVEL=INFO

# Stage 7.1 AI_* 只作为 YAML 缺失字段时的 fallback / CI Secret 来源。
# 普通最终用户优先直接配置 config/ai.yaml；Git 开发者可用 ignored config/ai.local.yaml。
# AI_PROVIDER=your-provider-profile
# AI_PROTOCOL=openai_chat_completions
# AI_API_BASE=https://your-provider-endpoint/v1
# AI_API_KEY=CHANGE_ME
# AI_MODEL=your-model-name
# AI_TIMEOUT=20
