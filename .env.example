# 可选的通用 OS 环境变量覆盖示例。
# 项目自身账号、域名、MySQL/Redis 等本地配置优先放在对应 env.<project>.yaml 中。
# OS 环境变量主要保留给 CI Secret、临时覆盖或历史 DSL 兼容。

# API_HOST=http://127.0.0.1:8000
# API_TIMEOUT=10
# API_VERIFY_SSL=false
# API_USE_MOCK=false
# LOG_LEVEL=INFO

# Stage 7.1 可选 AI 失败分析；不配置时普通测试与离线 Evidence 仍正常工作。
# AI_API_BASE=https://your-openai-compatible-endpoint/v1
# AI_API_KEY=CHANGE_ME
# AI_MODEL=your-model-name
# AI_TIMEOUT=20
