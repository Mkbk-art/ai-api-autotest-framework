.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
allure-results/
allure-report/
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep
extract.yaml
.env

.worktrees/

# IDE 本机元数据不属于框架源码，禁止再次进入版本库或发布包。
.idea/

# AI 私有本机覆盖文件可能包含真实 Provider Key，默认禁止提交。
config/ai.local.yaml

# 真实 SUT 账号、数据库密码等私有环境覆盖文件；通过 run.py --env-file 使用。
config/env.*.private.yaml
